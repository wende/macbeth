{
  "name": "macbeth",
  "version": "0.2.0",
  "description": "Playwright for macOS native apps — automation via the Accessibility API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wende/macbeth.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "macbeth": "./bin/macbeth.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "native/",
    "skills/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "../scripts/build-daemon.sh && npm run build && node ./scripts/sync-skills.mjs",
    "postpack": "node ./scripts/clean-skills.mjs",
    "test": "vitest run",
    "test:electron": "npm run build && node ./test-electron/run.mjs",
    "test:gui": "vitest run src/__tests__/test-harness.e2e.test.ts",
    "test:gui:foreground": "vitest run src/__tests__/mcp-demo-foreground.e2e.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "os": ["darwin"],
  "license": "MIT"
}
